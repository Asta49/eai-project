# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pcos_health?schema=public"

# Auth.js / NextAuth
NEXTAUTH_SECRET="pcos_health_super_secret_jwt_key_2026_demo_key_32chars"
NEXTAUTH_URL="http://localhost:3000"

# Sensitive Field Encryption at Rest (AES-256-GCM, 32-byte hex key)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# AI Configuration (mock, openai, google)
# In mock mode, intelligent deterministic generators produce realistic Zod-validated data without external keys
AI_PROVIDER="mock"
AI_MODEL="gpt-4o-mini"
AI_VISION_MODEL="gpt-4o"
EMBEDDING_MODEL="text-embedding-3-small"

# API Keys (optional if AI_PROVIDER="mock")
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Unit Economics Defaults
LLM_PRICE_PER_1M_INPUT_TOKENS_INR="12.5"
LLM_PRICE_PER_1M_OUTPUT_TOKENS_INR="50.0"
